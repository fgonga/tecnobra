# Tecnobra UI — copiar para `.env` e ajustar se mudares a porta da API.
#   cp .env-example .env          (Linux/macOS)
#   Copy-Item .env-example .env   (Windows PowerShell)

# Base da API. Tem de coincidir com APP_PORT do api/.env.
VITE_API_URL="http://127.0.0.1:9100"

# O Socket.IO é servido pelo mesmo processo da API — mesma porta.
VITE_SOCKET_URL="http://127.0.0.1:9100"

VITE_DEV="true"

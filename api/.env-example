# Tecnobra API — copiar para `.env` e preencher.
#   cp .env-example .env          (Linux/macOS)
#   Copy-Item .env-example .env   (Windows PowerShell)

# ---------- Aplicação ----------
NODE_ENV=development
APP_DEVELOPMENT=true
APP_URL="http://localhost"
APP_PORT=9100
SOCKET_PORT=9200
FRONTEND_URL="http://localhost:9300"

# Segredo de assinatura dos JWT — gerar um valor aleatório longo.
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET="alterar-para-um-segredo-aleatorio-longo"

# Password atribuída a utilizadores criados sem password definida.
DEFAULT_PASSWORD="tecnobra"

# ---------- MySQL ----------
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="tecnobra"

# ---------- Redis (BullMQ) ----------
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# ---------- Bull-Board (express.ts) ----------
# 9300 é a porta do frontend — usar outra para não colidir.
BULL_DASHBOARD_PORT=9400
BULL_PASSWORD="bull"

# ---------- Mocks de serviços externos ----------
# Com `true` nada é enviado para fora; o mock corre em MOCK_APP_PORT.
# Em desenvolvimento deixar os três a `true`.
USE_MOCK_SMS=true
USE_MOCK_WHATSAPP=true
USE_MOCK_EMAIL=true
MOCK_APP_PORT=3099

# ---------- SMS (telcosms) — só com USE_MOCK_SMS=false ----------
SMS_API_URL="https://www.telcosms.co.ao/api/v2/send_message"
SMS_API_KEY=""

# ---------- WhatsApp — só com USE_MOCK_WHATSAPP=false ----------
WHATSAPP_API_URL=""
WHATSAPP_DEVICE_ID="tecnobra"
WHATSAPP_GROUP_PHONE=""
WHATSAPP_USER=""
WHATSAPP_PASSWORD=""

# ---------- E-mail SMTP — só com USE_MOCK_EMAIL=false ----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Tecnobra <no-reply@tecnobra.local>"

# ---------- Webhook opcional para sistemas externos ----------
PARTNER_API=""
PARTNER_API_KEY=""

# ---------- Opcional ----------
ANTHROPIC_API_KEY=""
